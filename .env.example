NODE_ENV=development
PORT=5000

# MongoDB Atlas production format:
# MONGO_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/nutriai_db?retryWrites=true&w=majority
#
# Local development default. Docker Compose overrides this to mongodb://mongo:27017/
MONGO_URI=mongodb://localhost:27017/nutriai_db
MONGO_DB_NAME=nutriai_db

JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=30d

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# Set this to true on Netlify.
TRUST_PROXY=false

# Optional Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
APP_URL=http://localhost:5000
TUNNEL_PUBLIC_URL=
TUNNEL_AUTO_REDIRECT=true
TUNNEL_URL_FILE=.cloudflare_url
